// Configuracion de ejemplo para adquirir_desde_json.m
// Se admiten lineas de comentario que empiecen por //
{
  "device": {
    "resource": "PXI1Slot2",
    "driver": "pxi5922.mdd"
  },

  "channel": {
    "name": "0",
    "range_V": 1.0,
    "offset_V": 0.0,
    "coupling": "DC"
  },

  "horizontal": {
    "sample_rate_Hz": 1e6,
    "record_length": 1000,
    "ref_position_pct": 10,
    "num_records": 1000
  },

  // type: "immediate" | "edge"
  // source: "0" o "1" (canales), "VAL_EXTERNAL" (conector TRIG del panel frontal)
  "trigger": {
    "type": "edge",
    "source": "VAL_EXTERNAL",
    "level_V": 0.05,
    "slope": "rising",
    "holdoff_s": 0
  },

  "acquisition": {
    "fetch_mode": "block",
    "block_size": 100,
    "verify": true,
    "continuous_memory": false,
    "max_wait_s": 30
  },

  // data_type: "double" | "single"  (single ocupa la mitad)
  // compression: 0 (sin compresion) .. 9
  // plot: al terminar, dibuja los primeros plot_records registros (leidos del HDF5)
  //       y el histograma de intervalos entre triggers
  "output": {
    "folder": "datos",
    "file_prefix": "run",
    "data_type": "double",
    "compression": 0,
    "plot": true,
    "plot_records": 20
  },

  // Campos libres: se copian como atributos meta_<campo> en el fichero HDF5
  "metadata": {
    "operator": "",
    "sample": "",
    "temperature_mK": 0,
    "notes": "prueba de multirregistro"
  }
}
